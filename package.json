{
  "name": "noax-is",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --infer-origin-from-routes=false --var PUBLIC_HOST:localhost",
    "db:migrate:local": "wrangler d1 migrations apply noax-is --local",
    "db:migrate:remote": "node --env-file=.local/cloudflare.env node_modules/wrangler/bin/wrangler.js d1 migrations apply noax-is --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "node --env-file=.local/cloudflare.env node_modules/wrangler/bin/wrangler.js deploy",
    "cloudflare:inspect": "node --env-file=.local/cloudflare.env scripts/cloudflare.mjs inspect",
    "cloudflare:provision": "node --env-file=.local/cloudflare.env scripts/cloudflare.mjs provision",
    "mcp:check": "node scripts/check-mcp.mjs",
    "smoke": "node --env-file=.local/mcp.env scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "jose": "6.2.15",
    "markdown-it": "15.0.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "@cloudflare/workers-types": "5.20261104.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "4.157.0"
  }
}
