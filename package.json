{
  "name": "noax",
  "version": "0.1.0",
  "description": "A minimal single-author microblog: one Cloudflare Worker, one D1 database and five MCP publishing tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackf5/noax.is.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "npm run -s site:config && node --env-file=.local/cloudflare.env node_modules/wrangler/bin/wrangler.js d1 migrations apply DB --remote --config .local/wrangler.deploy.jsonc",
    "db:backfill-slugs:local": "node scripts/backfill-slugs.mjs --local",
    "db:backfill-slugs:remote": "npm run -s site:config && node --env-file=.local/cloudflare.env scripts/backfill-slugs.mjs --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test \"test/*.test.mjs\"",
    "build": "wrangler deploy --dry-run --outdir dist",
    "setup": "npm run -s cloudflare:provision && npm run -s db:migrate:remote && npm run -s db:backfill-slugs:remote && npm run -s deploy && npm run -s db:backfill-slugs:remote && npm run -s mcp:check",
    "site:config": "node scripts/site-config.mjs",
    "deploy": "npm run -s site:config && node --env-file=.local/cloudflare.env node_modules/wrangler/bin/wrangler.js deploy --config .local/wrangler.deploy.jsonc",
    "cloudflare:inspect": "node --env-file=.local/cloudflare.env scripts/cloudflare.mjs inspect",
    "cloudflare:provision": "node --env-file=.local/cloudflare.env scripts/cloudflare.mjs provision",
    "cloudflare:rotate": "node --env-file=.local/cloudflare.env scripts/cloudflare.mjs rotate",
    "mcp:check": "node scripts/check-mcp.mjs",
    "smoke": "node --env-file=.local/mcp.env scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "jose": "6.2.15",
    "markdown-it": "15.0.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "@cloudflare/workers-types": "5.20261104.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "4.157.0"
  }
}
