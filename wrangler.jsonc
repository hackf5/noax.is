{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noax",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "rules": [
    { "type": "Text", "globs": ["**/*.svg"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.ico"], "fallthrough": true }
  ],
  "vars": {
    "PUBLIC_HOST": "localhost",
    "MCP_HOST": "mcp.localhost",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "SITE_TITLE": "noax",
    "SITE_DESCRIPTION": "A minimal microblog.",
    "SITE_LOCALE": "en",
    "SITE_CONTENT_SIGNAL": "search=yes, ai-input=yes"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noax",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
